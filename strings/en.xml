<?xml version="1.0" encoding="UTF-8"?>
<!--
  The words the interface is made of, in English.

  This file is the one place the English is written: it is baked into the
  binary by tools/genstrings.py, and read at runtime so a change here
  shows without a rebuild.  A translation is a copy of this file named for
  its language (fr.xml, el.xml, ru.xml) with the values changed and
  the keys left alone.

  Keep it sorted by area, and never change a key: the key is the name the
  code knows a line by.  The … is a real ellipsis, not three dots.
-->
<strings lang="en">

