# shell: desktop
# home: fixture
# prefs: factory
# setup: benchstop
# board: only
# Hardware opt-in: monitored link-console run, never implicit flashing.
wait 60
click 980 30
wait 10
menu-pick Applications
wait 10
menu-pick Bench
wait 500
expect-title Bench
click-window Bench
click 71 8
wait 8
menu-pick Find suites
key l
key i
key n
key k
key -
key c
key o
key n
key s
key o
key l
key e
wait 12
click 71 8
wait 8
menu-pick Select visible
click 71 8
wait 8
menu-pick Run selected...
note Run must be explicitly chosen; Return alone would cancel.
key Tab
key Return
wait 150
click-window Bench
click 71 8
wait 8
menu-pick Stop
wait 300
expect-title Bench
note Results now stay in the main Bench window.
wait 500
expect-read /devices/nrf54lm20b/sys/device/name tiku
quit
