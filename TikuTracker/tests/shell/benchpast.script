# shell: desktop
# home: fixture
# prefs: factory
# setup: benchpast
# board: only
# mount: /devices/board1
# The profile-aware ledger is now a tab; semantic history checks are in test_bench.
wait 60
click 980 30
wait 10
menu-pick Device Tools
wait 10
menu-pick TikuBench
wait 500
expect-title Bench
click-window Bench
click 128 8
wait 8
expect-menu History
expect-menu Benchmarks
menu-pick History
wait 20
expect-title Bench
quit
