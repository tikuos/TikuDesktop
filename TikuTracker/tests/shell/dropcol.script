# shell: desktop
# PVL-027: dragged out of a LIST there is no arrangement to preserve, so
# the icons stack in a column at the drop point rather than in a heap.
note window one is a list; open sub with a double click on its row
click-row 0
wait 2
click-row 0
wait 8
key 1 ctrl
wait 6
drag-window /sub 620 420
wait 6
note two rows, dropped on the icon window's background at 600,500
click-window /tmp/trk_script
wait 3
click-row 1
wait 2
click-row 2 1 ctrl
wait 2
press-row 1
move 300 200
move 600 500
release 600 500
wait 20
click 580 414
wait 5
expect-icon-screen a.txt 600 500
expect-icon-screen b.txt 600 520
quit
