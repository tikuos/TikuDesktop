# shell: desktop
# The shipped examples and board utilities have separate system submenus.
# Only inspect menu contents: no board tests or console commands are run.
wait 20
click 980 20
wait 4
menu-pick Documents
wait 4
expect-menu Editor|Sticky Notes|TikuDoc|TikuMarker|TikuPDF|TikuReader|TikuSlides
shot /tmp/trk_documents_menu.png
click 500 700
wait 4
click 980 20
wait 4
menu-pick Graphics & Design
wait 4
expect-menu TikuCircuit|TikuGrab|TikuImage
click 500 700
wait 4
click 980 20
wait 4
menu-pick Utilities
wait 4
expect-menu Calculator|Terminal|TikuArchive
click 500 700
wait 4
click 980 20
wait 4
menu-pick Development
wait 4
expect-menu Developer Calculator|TikuBasic|TikuC|TikuDiff|TikuHex
click 500 700
wait 4
click 980 20
wait 4
menu-pick Device Tools
wait 4
expect-menu Device Monitor|TikuBench|TikuConsole|TikuSDR|VFS Inspector
shot /tmp/trk_device_tools_menu.png
click 500 700
wait 4
click 980 20
wait 4
menu-pick Demos
wait 4
expect-menu Clock|Counter|Hello|Sensors|Sketch|Twowin
shot /tmp/trk_demos_menu.png
key Escape
