# shell: desktop
# Grouped Font Preferences uses native dialog keyboard navigation.
# Pointer capture, all sizes and layout geometry are covered by test_fonts_window.
wait 15
key w ctrl
wait 5
click 980 20
wait 4
menu-pick Settings
wait 4
menu-pick Fonts
wait 12
expect-title Fonts
expect-font Sans 12
shot /tmp/trk_fonts_sans.png
note choosing another family redraws everything, this window included
key Down
wait 12
expect-font Serif 12
shot /tmp/trk_fonts_serif.png
key Down
wait 12
expect-font Mono 12
shot /tmp/trk_fonts_mono.png
note Tab moves from Family to Minus, then Plus
key Tab
key Tab
key Return
wait 12
expect-font Mono 14
key Return
wait 12
expect-font Mono 16
shot /tmp/trk_fonts_16.png
note reopen to reset keyboard focus; at maximum size Plus is skipped
key w ctrl
wait 6
click 980 20
wait 4
menu-pick Settings
wait 4
menu-pick Fonts
wait 12
key Tab
key Tab
key Return
wait 12
expect-font Sans 12
shot /tmp/trk_fonts_default.png
note Escape closes the preferences without undoing the live choice
key Escape
wait 6
expect-no-title Fonts
