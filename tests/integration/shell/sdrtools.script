click-row 0
wait 2
click-row 0
wait 180
expect-title TikuSDR
click 114 8
wait 4
expect-menu Save Named Setup…
expect-menu Open Reference Trace…
expect-menu Bookmark
expect-menu Set Loop Start Here
menu-pick Bookmark
wait 6
click 158 8
wait 4
expect-menu Channel Activity
menu-pick Channel Activity
wait 8
expect-pixel 400 200 ffffff
shot /tmp/trk_sdr_activity.png
click 158 8
wait 4
expect-menu Channels: Wi-Fi (Cycle)
menu-pick Channels: Wi-Fi (Cycle)
wait 8
shot /tmp/trk_sdr_ble.png
click 158 8
wait 4
expect-menu Channels: BLE (Cycle)
