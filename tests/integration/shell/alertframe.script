# shell: desktop
# home: fixture
# An alert wears the two-ring border the menus wear, a light bevel just
# inside it, and R5 buttons -- the default one in its ring.
wait 10
press 900 20 1
wait 2
release 900 20 1
wait 4
menu-pick Shut down
wait 5
note the alert's two dark rings, with the light bevel just inside them
expect-pixel 290 250 363636
expect-pixel 291 250 363636
expect-pixel 292 250 dcdcdc
note the warning wears its icon: the yellow disc and its exclamation,
note on the grey stripe BAlert lays them on
expect-pixel 310 212 ffcb00
expect-pixel 318 212 000000
expect-pixel 300 280 d4d4d4
note and the default button's ring around Shut down
expect-pixel 603 301 828282
key Escape
wait 3
expect-file /tmp/trk_script/a.txt
quit
