# shell: desktop
# home: fixture
# Increasing the Deskbar font enlarges the same menu's rows.
wait 12
click 980 20
wait 2
expect-font Sans 12
note the 12 px menu ends at 271, below the 14 px menu's bottom of 295
expect-under menu-bottom 283
menu-pick Settings
wait 3
menu-pick Deskbar preferences
wait 5
note increase the text size with the plus button
click 715 270
wait 3
key w ctrl
wait 3
click 980 20
wait 3
expect-font Sans 14
note the larger font moves the menu bottom past the same boundary
expect-over menu-bottom 283
quit
