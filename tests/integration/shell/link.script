# shell: desktop
# FS-002: the link modifier has a variant.  A drop that made a link always
# made an absolute one, so the one case a link is worth having -- a folder
# that can be moved with its links intact -- could not be asked for.
wait 8
note dropped into sub with the link modifier and Shift
press-row 1
move-row 0
move-row 0
release-row 0 1 ctrl shift
wait 25
expect-link /tmp/trk_script/sub/a.txt ../a.txt
quit
