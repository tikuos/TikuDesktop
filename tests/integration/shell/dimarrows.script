# shell: tracker
# setup: bandscroll
# NeXT UIG ch7: an arrow that cannot scroll any further says so -- at the
# top the up arrow's glyph is dimmed while the down arrow's is full ink,
# and one step down restores the up arrow.
wait 8
expect-pixel 746 99 a8a8a8
expect-pixel 746 490 828282
click 747 490
wait 3
expect-pixel 746 99 828282
quit
