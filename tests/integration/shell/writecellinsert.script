# shell: desktop
# prefs: factory
# open: /tmp/trk_home/documents
# Copy a row, close its process, insert a new table and undo the whole edit.
wait 25
click-row 0
wait 2
click-row 0
wait 100
expect-title table.tkrd
click 150 140
click 334 8
wait 5
menu-pick Select row
wait 10
key c ctrl
wait 25
key w ctrl
wait 25
expect-no-title TikuWrite
click 980 30
wait 4
menu-pick Documents
wait 4
menu-pick TikuWrite
wait 100
expect-title Untitled
key v ctrl
wait 30
expect-title * Untitled
expect-pixel 300 150 bbd0e7
expect-pixel 700 150 ffffff
expect-same-as-redraw
shot /tmp/tiku-write-table-insert.png
key z ctrl
wait 20
expect-title Untitled
expect-pixel 300 150 ffffff
expect-same-as-redraw
key z ctrl shift
wait 20
expect-title * Untitled
expect-same-as-redraw
shot /tmp/tiku-write-table-insert-redo.png
