# shell: desktop
# prefs: factory
# setup: sdr
# TikuSDR opened with no ESP32-C61 connected through Devices says no
# software-defined radio is detected at once, over its own window, with
# the stop icon and one button: Return closes TikuSDR, and so does a click
# on OK when it is opened again.
wait 60
click 980 30
wait 10
menu-pick Device Tools
wait 10
menu-pick TikuSDR
wait 200
expect-title TikuSDR
shot /tmp/trk_sdr_noesp32.png
note The stop icon's red, left of its cross, on the alert's stripe
expect-pixel 309 233 cb3030
expect-windows 2
key Return
wait 30
expect-no-title TikuSDR
expect-windows 1
note Opened again, a click on OK closes it too
click 980 30
wait 10
menu-pick Device Tools
wait 10
menu-pick TikuSDR
wait 200
expect-title TikuSDR
expect-pixel 309 233 cb3030
expect-windows 2
click 669 323
wait 30
expect-no-title TikuSDR
expect-windows 1
quit
