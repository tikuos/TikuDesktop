# shell: desktop
# file: work/sub/target.txt target
# AW-076: the info icon's menu carries the items the source adds for it
# alone -- a folder offers Recalculate folder size, a symlink offers Set
# new link target, and choosing it raises the re-point picker.
wait 10
note a folder's info icon offers the recount
click-row 0
wait 2
key i ctrl
wait 10
click 150 132 3
wait 3
expect-menu Recalculate folder size
menu-pick Recalculate folder size
wait 5
key w ctrl
wait 3
note a link's info icon offers the re-point, which raises the picker
click-row 1 3
wait 3
menu-pick Create link
wait 3
menu-pick Current folder
wait 10
expect-file /tmp/trk_script/a.txt link
wait 40
click-row 2
wait 2
key i ctrl
wait 10
click 150 132 3
wait 3
expect-menu Set new link target
menu-pick Set new link target
wait 5
expect-title Open
note choosing sub/target.txt replaces the link target rather than moving a selection
expect-rows 5
click 400 200
click 400 200
wait 5
expect-rows 1
click 400 200
wait 3
click 675 413
wait 20
expect-link /tmp/trk_script/a.txt link /tmp/trk_script/sub/target.txt
expect-file /tmp/trk_script/b.txt
note a link can point at a folder: open it and press Open with no row picked
click 150 132 3
wait 3
menu-pick Set new link target
wait 5
expect-title Open
click 400 200
click 400 200
wait 5
expect-rows 1
click 675 413
wait 20
expect-link /tmp/trk_script/a.txt link /tmp/trk_script/sub
quit
