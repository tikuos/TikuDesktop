# shell: desktop
# prefs: factory
# mkdir: /tmp/trk_home
# file: ~/reader.md # Reader document
# A separate reader application, not the Help document mode.
wait 20
click 980 40
wait 4
menu-pick Applications
wait 4
shot /tmp/trk_reader_menu.png
menu-pick TikuReader
wait 16
expect-title TikuReader
expect-narrate A quiet place to read local documents
expect-no-title Help
note the Reader's real title-tab zoom button maximizes and restores
expect-window-at 90 40
click 208 50
wait 8
expect-window-at 0 21
shot /tmp/trk_reader_maximized.png
click 120 32
wait 8
expect-window-at 90 40
note compact toolbar controls still expose useful hover tips
move 216 86
wait 8
expect-narrate Open document (Ctrl+O)
move 450 400
wait 4
click 60 8
wait 4
expect-menu Open
menu-pick Open
wait 12
expect-title Open
key Escape
wait 8
expect-no-title Open
click-window TikuReader
key o ctrl
wait 12
expect-title Open
click 400 200
wait 4
click 675 413
wait 16
expect-no-title Open
expect-title TikuReader
expect-narrate Reader document
key f ctrl
key d
key o
key c
key u
key m
key e
key n
key t
key Return
wait 8
expect-no-title Find
expect-narrate Match 1 of 1
key r ctrl
wait 8
expect-narrate Reloaded from disk
key Escape
key l ctrl
key a ctrl
key r
key e
key a
key d
key e
key r
key .
key m
key d
key Return
wait 8
expect-title TikuReader
expect-narrate Reader document
shot /tmp/trk_document_reader.png
key F1
wait 12
expect-title Help
expect-narrate Opening documents
key w ctrl
wait 8
expect-no-title Help
click-window TikuReader
expect-title TikuReader
key q ctrl
wait 8
expect-no-title TikuReader
quit
