# shell: desktop
# TS-037: the count view says how much of the folder is picked out.  It
# counted the folder and said nothing about the selection, so the one
# number that changes as you work was the one it did not show.
wait 8
expect-count 4 items
click-row 1
wait 3
expect-count 1/4 selected
expect-selected-name a.txt
key a ctrl
wait 3
expect-count 4/4 selected
quit
