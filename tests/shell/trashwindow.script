# shell: desktop
# argv: trash
# CW-031/CW-042: menu rules know this window is the Trash.
wait 8
note a Trash window gets its own File-menu inventory
click 65 75
wait 3
expect-menu Empty Trash
expect-menu Delete
expect-menu Restore
note a pose in the Trash gets Delete and Restore, not Duplicate
click 700 700
click-row 1 3
wait 3
expect-menu Delete
expect-menu Restore
quit
