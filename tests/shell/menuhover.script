# shell: desktop
# A menu says which item a pick would take: the row under the pointer is
# highlighted, and it follows the pointer out again.
wait 8
click-row 1
wait 2
press-row 1 3
wait 2
release-row 1 3
wait 5
expect-pixel 195 200 d8d8d8
move 120 200
wait 3
expect-pixel 195 200 336698
note and a pointer that leaves takes the highlight with it
move 400 460
wait 3
expect-pixel 195 200 d8d8d8
quit
