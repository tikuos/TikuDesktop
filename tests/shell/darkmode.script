# shell: desktop
# home: fixture
# Dark mode is a theme swap through the toolkit's one table: the setting
# applies the moment it is read (no OK button), every surface follows,
# and the identity survives -- the active tab keeps its yellow.
wait 12
expect-pixel 500 660 336698
note flip the setting behind the shell's back: the file IS the switch
write /tmp/trk_home/.config/TrackerSettings DarkMode on
wait 20
expect-pixel 500 660 1c2a3a
note the panels darken with it, and the tab stays Be yellow
expect-pixel 60 42 ffcb00
note the list ground reads the theme too: dark below the last row
expect-pixel 300 250 1e1e1e
note and back: NULL restores the R5 table exactly
write /tmp/trk_home/.config/TrackerSettings DarkMode off
wait 20
expect-pixel 500 660 336698
quit
