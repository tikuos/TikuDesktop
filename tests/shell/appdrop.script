# shell: desktop
# PVS-044: dropping a document on an application pose launches it with the
# document as its argument, filtered to the types the target claims.
wait 10
note drag a.txt (text/plain, claimed) onto the Dropper's pose
press-row 1
move 90 160
move 90 180
move 90 198
release 90 198
wait 8
expect-file /tmp/trk_launched
note the record names the document that was handed over
expect-file-has /tmp/trk_launched a.txt
note now a document whose type the Dropper does NOT claim: nothing launches
remove /tmp/trk_launched
press-row 0
move 90 160
move 90 180
move 90 198
release 90 198
wait 8
expect-no-file /tmp/trk_launched
note but Control forces the unclaimed document through the filter
press-row 0
move 90 160
move 90 180
move 90 198
release 90 198 1 ctrl
wait 8
expect-file /tmp/trk_launched
expect-file-has /tmp/trk_launched sub
quit
