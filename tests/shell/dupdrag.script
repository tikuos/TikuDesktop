# shell: tracker
# FS-004: with Option held, a drag inside the folder DUPLICATES instead of
# repositioning -- the poses go back where they were, and copies appear.
wait 8
key 1 ctrl
wait 8
press 160 110 1 alt
move 200 200 1 alt
move 260 220 1 alt
release 260 220 1 alt
wait 30
expect-file /tmp/trk_script/a.txt copy
expect-file /tmp/trk_script/a.txt
quit
