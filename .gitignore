# Build output.  Everything under here is derived from the sources beside it.
build/

# Editor and OS leavings.
*.o
*.swp
.DS_Store

# HIG reference documents, kept beside the code but not in it.
temp/

# Python's bytecode cache.  The generators under tools/ are run by hand,
# and each run leaves one of these beside them.
__pycache__/
*.pyc
