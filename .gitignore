# Build output, in every corner of the tree: derived from the sources
# beside it, never carried.
build/
dist/

# Editor and OS leavings.
*.o
*.swp
.DS_Store

# Reference documents kept beside the code but not in it.
temp/

# Python's bytecode cache, left behind by the hand-run generators.
__pycache__/
*.pyc
build-*/
